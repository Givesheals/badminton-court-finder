# Badminton Court Finder – example environment variables
# Copy this file to .env and fill in your values. Do not commit .env.

# OpenAI API key – required for scraping (all scrapers use LLM extraction)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=paste-your-openai-api-key-here

# Optional: facilities to skip in scheduled scrape-all (comma-separated). Default: none.
# EXCLUDE_SCRAPE_FACILITIES=

# Venue login credentials (for scrapers that need them)
# LVC_USERNAME=your-email@example.com
# LVC_PASSWORD=your-password
# LOGIN_USERNAME=your-email@example.com
# LOGIN_PASSWORD=your-password

# Database (optional – default is SQLite locally)
# DATABASE_URL=postgresql://user:pass@host/dbname
